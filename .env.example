# Day-off — environment template. Copy to .env and fill in.
# Only VITE_* vars are exposed to the client bundle.

# Axiom (logging transport, standard #5). Leave empty to log to console only.
# NOTE: a client-side ingest token is embedded in the bundle — use a write-only,
# dataset-scoped token, never an admin token.
VITE_AXIOM_DATASET=
VITE_AXIOM_TOKEN=

# App metadata (surfaced in logs / error reports)
VITE_APP_VERSION=0.0.0
VITE_ENVIRONMENT=development

# Soft-launch flags
VITE_ENABLE_LANGUAGE_PICKER=false
